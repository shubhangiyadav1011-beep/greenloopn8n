# Run Node 24 or newer. Copy this file to .env when configuring integrations.
PORT=3001
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:5173

# Explicit fallback: sqlite. Switch to postgres after applying SQL migrations.
# If omitted, a configured SUPABASE_DB_URL selects postgres; otherwise sqlite.
DATABASE_PROVIDER=sqlite
# Backend only: Supabase Connect > direct connection or session pooler (port 5432).
# URL-encode special characters in the database password.
SUPABASE_DB_URL=
# Optional path to the Supabase CA certificate; remote TLS is always verified.
SUPABASE_DB_CA_FILE=
# Backend-only private evidence storage. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Reserved for future integrations; not used by the current frontend/backend.
SUPABASE_ANON_KEY=
# Google OAuth web application credentials (optional).
# Authorized redirect URI: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# HTTPS email delivery webhook (optional in development; required for production recovery).
# Receives JSON: { "to": "...", "subject": "...", "text": "..." }
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
TINYFISH_API_KEY=
BRAVE_SEARCH_API_KEY=

# For deployment set NODE_ENV=production and PUBLIC_ORIGIN to your HTTPS domain.
# Build first; npm start serves frontend/dist and the API on PORT.
